NODE_ENV=production
PORT=3001

# Origem(s) autorizada(s) a chamar /api/contato — separadas por vírgula
ALLOWED_ORIGIN=https://rootforceusinagem.vercel.app

# URL pública do site, usada nos links dos emails de confirmação
SITE_URL=https://rootforceusinagem.vercel.app

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Destino dos emails de lead (padrão: producao@rootforceusinagem.com.br)
COMPANY_EMAIL=producao@rootforceusinagem.com.br

# URL pública da logo para uso nos emails (opcional — cai para base64 inline se vazio)
LOGO_URL=
